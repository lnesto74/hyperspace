# ==============================================
# Hyperspace Production Environment Variables
# Copy this to .env on the server and fill in values
# ==============================================

# Server
PORT=3001
NODE_ENV=production

# Database (persistent Docker volume)
DB_PATH=/data/db/hyperspace.db

# LiDAR
MOCK_LIDAR=false
LIDAR_PORT=17161

# MQTT (Mosquitto runs in same Docker network)
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Tailscale
TAILSCALE_POLL_INTERVAL=30000
SHOW_ALL_TAILSCALE_DEVICES=true

# Edge Server (update with your edge device's Tailscale IP)
EDGE_SERVER_URL=http://100.x.y.z:8080

# Feature Flags
FEATURE_DWG_IMPORTER=true
FEATURE_LIDAR_PLANNER=true
FEATURE_DOOH_KPIS=true
FEATURE_DOOH_ATTRIBUTION=true
FEATURE_BUSINESS_REPORTING=true
FEATURE_NARRATOR2_OPENAI=true

# Domain for Caddy HTTPS (set to your domain, or remove for IP-only access)
DOMAIN=app.yourdomain.com

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=542005245974-0mftq2e7vlkqk99mt8cpdj4jkeslva89.apps.googleusercontent.com
SUPERADMIN_EMAIL=ln@ulisse.tech
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# ---- SECRETS (fill in on server, NEVER commit) ----
OPENAI_API_KEY=sk-proj-CHANGE_ME
OPENAI_MODEL=gpt-4o
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=Hyperspace <noreply@yourdomain.com>
LEAD_NOTIFICATION_EMAIL=you@yourdomain.com
