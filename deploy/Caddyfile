# Hyperspace Production Caddyfile
# For IP-only HTTP access (no domain/HTTPS)

:80 {
    # Frontend - static files
    handle {
        reverse_proxy frontend:4173
    }

    # Backend API
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Socket.IO - WebSocket upgrade support
    handle /socket.io/* {
        reverse_proxy backend:3001 {
            transport http {
                versions 1.1 2
            }
        }
    }

    # WebSocket for point cloud data
    handle /ws/* {
        reverse_proxy backend:3001 {
            transport http {
                versions 1.1 2
            }
        }
    }

    # Uploaded files (logos, DOOH videos, floor plans)
    handle /uploads/* {
        reverse_proxy backend:3001
    }

    # Compression for performance
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}
