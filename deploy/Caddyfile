# Hyperspace Production Caddyfile
# For IP-only HTTP access (no domain/HTTPS)

:80 {
    # Backend API
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Socket.IO - WebSocket upgrade support
    handle /socket.io/* {
        reverse_proxy backend:3001
    }

    # WebSocket for point cloud data
    handle /ws/* {
        reverse_proxy backend:3001
    }

    # Uploaded files (logos, DOOH videos, floor plans)
    handle /uploads/* {
        reverse_proxy backend:3001
    }

    # Frontend - static files (MUST BE LAST - catch-all)
    handle {
        reverse_proxy frontend:4173
    }

    # Compression for performance
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logging with rotation (prevent disk fill)
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 3
            roll_keep_for 168h
        }
        format json
    }
}
