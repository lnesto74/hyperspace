# Hyperspace Production Caddyfile
# Domain: app.hyspace.app (auto HTTPS via Let's Encrypt)

# HTTP/3 (QUIC) was stalling the 3.5MB JS bundle for some Chrome clients
# (H3_REQUEST_CANCELLED / 29s idle timeout → blank black shell). Prefer H1/H2.
{
	servers {
		protocols h1 h2
	}
}

# IP address handler for edge server access (no HTTPS)
:80 {
    # Backend API
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Socket.IO - WebSocket upgrade support
    handle /socket.io/* {
        reverse_proxy backend:3001
    }

    # Uploaded files
    handle /uploads/* {
        reverse_proxy backend:3001
    }

    # Benchmark story strip
    handle /benchmark-story-strip.html {
        reverse_proxy backend:3001
    }
    handle /presentation/* {
        reverse_proxy backend:3001
    }
    handle /docs-assets/* {
        reverse_proxy backend:3001
    }

    # Shelf mapper (Next.js)
    handle /m/* {
        reverse_proxy shelf-mapper:3000
    }
    handle /_next/* {
        reverse_proxy shelf-mapper:3000
    }
    handle /floorplans/* {
        reverse_proxy shelf-mapper:3000
    }

    # Fallback
    handle {
        respond "Use app.hyspace.app for frontend" 200
    }
}

app.hyspace.app {
    # Backend API
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Socket.IO - WebSocket upgrade support
    handle /socket.io/* {
        reverse_proxy backend:3001
    }

    # WebSocket for point cloud data
    handle /ws/* {
        reverse_proxy backend:3001
    }

    # Uploaded files (logos, DOOH videos, floor plans)
    handle /uploads/* {
        reverse_proxy backend:3001
    }

    # Benchmark story strip (Canva screenshot page — served by backend)
    handle /benchmark-story-strip.html {
        reverse_proxy backend:3001
    }
    handle /presentation/* {
        reverse_proxy backend:3001
    }
    handle /docs-assets/* {
        reverse_proxy backend:3001
    }

    # Shelf mapper (Next.js) — customer floorplan pin tool
    handle /m/* {
        reverse_proxy shelf-mapper:3000
    }
    handle /_next/* {
        reverse_proxy shelf-mapper:3000
    }
    handle /floorplans/* {
        reverse_proxy shelf-mapper:3000
    }

    # Frontend - static files (MUST BE LAST - catch-all)
    handle {
        reverse_proxy frontend:4173
    }

    # Compression for performance
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        # Allow Google OAuth popup to communicate with parent window
        Cross-Origin-Opener-Policy same-origin-allow-popups
    }

    # Logging with rotation (prevent disk fill)
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 3
            roll_keep_for 168h
        }
        format json
    }
}
