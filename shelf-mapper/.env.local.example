# Persistence: local | api | supabase
# Production on DO uses api (Hyperspace backend SQLite)
NEXT_PUBLIC_PERSISTENCE=local

# Supabase (only needed when NEXT_PUBLIC_PERSISTENCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Owner secret for /m/[token]/results?secret=...
# Set per-project in DB (owner_secret column) or use this global fallback
RESULTS_SECRET=change-me

# Optional webhook when customer submits
SUBMIT_WEBHOOK_URL=
