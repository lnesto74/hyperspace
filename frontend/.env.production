# Production: empty string means all API calls use relative URLs
# Caddy reverse proxy handles routing /api/* and /socket.io/* to backend
VITE_API_URL=

# Google OAuth Client ID (configured for https://app.hyspace.app)
VITE_GOOGLE_CLIENT_ID=945022199671-du9ec6aa1ks2lad4oha4lksdef5l6lig.apps.googleusercontent.com

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCy-JmM_cwIpVxaYVJmfsfgolBogcVPqsk

# Feature Flags
VITE_FEATURE_LAUNCHPAD=true

# Demo links are minted from the UI (superadmin → Demo Links) and validated by
# the backend, so no token env var is needed. Optionally set a default venue to
# pin for demos that don't specify one:
# VITE_DEMO_VENUE_ID=
