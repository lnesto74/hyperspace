# Production: empty string means all API calls use relative URLs
# Caddy reverse proxy handles routing /api/* and /socket.io/* to backend
VITE_API_URL=

# Google OAuth Client ID — leave empty to skip login (auth disabled)
# Set this when you have a proper domain configured in Google Cloud Console
# VITE_GOOGLE_CLIENT_ID=542005245974-0mftq2e7vlkqk99mt8cpdj4jkeslva89.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
